           "example": 10
          },
          "closed_count": {
           "type": "integer",
           "description": "Count of issues with status 'closed'",
           "example": 10
          },
          "in_progress_count": {
           "type": "integer",
           "description": "Count of issues with status 'in_progress'",
           "example": 4
