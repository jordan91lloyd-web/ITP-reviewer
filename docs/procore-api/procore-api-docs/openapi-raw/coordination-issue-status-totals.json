    "summary": "Show Coordination Issue Count by Status",
    "description": "Returns the count of Coordination Issues in a project, grouped by status.",
    "tags": [
     "Coordination Issues"
    ],
    "parameters": [
     {
      "name": "project_id",
      "in": "query",
      "required": true,
      "description": "Unique identifier for the project.",
      "schema": {
       "type": "integer"
      }
     },
     {
      "name": "workflow_issues",
      "in": "query",
      "description": "When true, returns status counts for workflow-linked Coordination Issues instead of standard (non-workflow) issues. Defaults to false.",
      "schema": {
       "type": "boolean"
      }
     }
    ],
    "responses": {
     "200": {
