            "materials_enabled": {
             "type": "boolean",
             "example": true
            },
            "labor_enabled": {
             "type": "boolean",
             "example": true
            },
            "equipment_enabled": {
             "type": "boolean",
             "example": true
            },
            "subcontractors_enabled": {
             "type": "boolean",
             "example": true
            }
           }
          },
