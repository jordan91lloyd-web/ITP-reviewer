           "example": "$"
          },
          "currency_display": {
           "type": "string",
           "description": "Currency Display",
           "example": "symbol"
          },
          "currency_iso_code": {
           "type": "string",
           "description": "Currency ISO Code",
           "example": "USD"
          },
          "timecard_employees_see_all_projects": {
           "type": "boolean",
           "description": "Timecard Employees Can See All Projects",
           "example": true
