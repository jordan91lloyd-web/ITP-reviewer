            "type": "integer"
           },
           "example": [
            1,
            2,
            3
           ]
          },
          "timesheet_type": {
           "type": "array",
           "description": "Timesheet IDs With Enabled Cost Type",
           "items": {
            "type": "integer"
           },
           "example": [
            1,
            2,
            3
           ]
          },
          "enable_sd_storage": {
           "type": "boolean",
           "description": "SD Storage Enabled",
           "example": true
          },
          "timesheets_custom_signature_text": {
           "type": "string",
           "description": "Timesheets Custom Signature Text",
           "example": "Custom signature text"
          },
          "timesheets_week_start_day": {
           "type": "integer",
           "description": "Timesheets Week Starting Day",
           "example": 1
          },
          "use_24_hour_mode": {
           "type": "boolean",
           "description": "Use 24 Hour Clock",
           "example": true
          },
          "timesheets_tab_enabled": {
           "type": "boolean",
           "description": "Timesheets Tab Enabled",
           "example": true
