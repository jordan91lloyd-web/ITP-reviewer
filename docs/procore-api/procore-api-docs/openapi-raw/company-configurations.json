 "paths": {
  "/rest/v1.0/company_configuration": {
   "get": {
    "x-doc": {
     "visibility": "public",
     "stage": "ga",
     "exposure": "public"
    },
    "summary": "Show Company Configuration",
    "description": "Returns company configuration.",
    "parameters": [
     {
      "name": "company_id",
      "in": "query",
      "description": "Unique identifier for the company.",
      "required": true,
      "schema": {
       "type": "integer"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Success",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "strict_file_uploading": {
           "type": "boolean",
           "description": "Strict File Uploading Allowed",
           "example": true
          },
          "enable_image_real_time_as_builts": {
           "type": "boolean",
           "description": "Image Real Time As Builts Enabled",
           "example": true
          },
          "currency_symbol": {
           "type": "string",
