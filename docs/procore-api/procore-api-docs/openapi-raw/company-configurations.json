             "project_id": {
              "type": "integer",
              "description": "ID of the project",
              "example": 1234
             },
             "timecard_default_lunch_time": {
              "type": "integer",
              "description": "Timecard default lunch time in minutes",
              "minimum": 0,
              "maximum": 60,
              "example": 60
             }
            }
           }
          },
          "projects_timecard_default_start_time": {
           "type": "array",
           "description": "Project Configurations whose timecard_default_start_time is not nil",
           "items": {
            "type": "object",
            "properties": {
             "project_id": {
              "type": "integer",
              "description": "ID of the project",
              "example": 1234
             },
             "timecard_default_start_time": {
              "type": "string",
              "description": "Timecard default start time in format HH:MM",
              "default": "8:00"
             }
            }
           }
          },
          "projects_timecard_default_stop_time": {
           "type": "array",
           "description": "Project Configurations whose timecard_default_stop_time is not nil",
           "items": {
            "type": "object",
            "properties": {
             "project_id": {
              "type": "integer",
              "description": "ID of the project",
              "example": 1234
             },
             "timecard_default_stop_time": {
              "type": "string",
              "description": "Timecard default stop time in format HH:MM",
              "default": "17:00"
             }
            }
           }
          },
          "projects_timecard_lunch_time_tracking": {
           "type": "array",
           "description": "Project Configurations whose timecard_lunch_time_tracking is not nil",
           "items": {
            "type": "object",
            "properties": {
             "project_id": {
              "type": "integer",
              "description": "ID of the project",
              "example": 1234
             },
             "timecard_lunch_time_tracking": {
              "type": "string",
              "description": "Timecard lunch time tracking",
              "example": "total_time"
             }
            }
           }
          },
          "task_codes_enabled": {
           "type": "boolean",
           "description": "Task codes enabled",
           "example": true
          },
          "timecard_employees_can_select_non_budgeted_items": {
           "type": "array",
           "description": "Timecard Employees can select non budgeted items",
           "items": {
            "type": "integer"
           }
          },
          "timecards_private": {
           "type": "boolean",
           "description": "Timecards private by default",
           "example": true
          },
          "timesheet_default_cost_type_id": {
           "type": "integer",
           "description": "Company Timesheet Budget Configuration default line item type id for non-erp integrated projects",
           "example": 12
          },
          "timesheet_erp_default_cost_type_id": {
           "type": "integer",
           "description": "Company Timesheet Budget Configuration default line item type id for erp integrated projects",
           "example": 13
          },
          "timesheet_equipment_default_cost_type_id": {
           "type": "integer",
           "description": "Company Timesheet Budget Configuration default equipment line item type id for non-erp integrated projects",
           "example": 14
