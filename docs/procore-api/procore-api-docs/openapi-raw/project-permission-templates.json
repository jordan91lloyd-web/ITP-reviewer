 "paths": {
  "/rest/v1.0/projects/{project_id}/permission_templates": {
   "get": {
    "x-doc": {
     "visibility": "public",
     "stage": "ga",
     "exposure": "public"
    },
    "summary": "List all available permission templates for a Project",
    "description": "Returns the name, id, and project specific status for all Permission Templates available to use on the specified Project for those with Admin Permissions. If a user has access to the Directory Granular Permission of 'Create and Edit Users' they will be able to fetch a list of their assignable templates if they pass the filter `assignables_only` as true",
    "tags": [
     "Project Permission Templates"
    ],
    "parameters": [
     {
      "name": "project_id",
      "in": "path",
      "required": true,
      "description": "Unique identifier for the project.",
      "schema": {
       "type": "integer"
      }
     },
     {
      "name": "filters[assignables_only]",
      "in": "query",
      "description": "Returns user's assignable permission templates",
      "required": false,
      "schema": {
       "type": "boolean"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Success",
      "content": {
       "application/json": {
        "schema": {
         "type": "array",
         "items": {
          "type": "object",
          "properties": {
           "id": {
            "type": "integer",
            "description": "The ID of the Permission Template",
            "example": 1
           },
           "name": {
            "type": "string",
            "example": "General Contractor",
            "description": "The name of the Permission Template"
           },
           "project_specific": {
            "type": "boolean",
            "description": "If the Permission Template is project specific",
            "example": true
           },
           "type": {
            "type": "string",
            "enum": [
             "project_specific",
             "company_tools",
             "global"
            ],
            "description": "Permission Template type",
            "default": "global",
            "example": "global"
           },
           "category": {
            "type": "string",
            "nullable": true,
            "enum": [
             "internal",
             "external"
            ],
            "description": "The category of the Permission Template",
            "example": "internal"
           }
          },
          "example": {
           "id": 1,
           "name": "General Contractor",
           "project_specific": true
          }
         }
        },
        "examples": {
         "response": {
          "value": [
           {
            "id": 1,
            "name": "General Contractor",
            "project_specific": false
           },
           {
            "id": 2,
            "name": "Subcontractor",
            "project_specific": true
           }
          ]
         }
        }
       }
      }
