    },
    "summary": "List Companies",
    "description": "Return a list of Companies visible to the User.\n\nNOTE: This endpoint does not require the ['Procore-Company-Id' header]\n(https://developers.procore.com/documentation/tutorial-mpz)\nto be included on a request.",
    "tags": [
     "Companies"
    ],
    "parameters": [
     {
      "name": "page",
      "in": "query",
      "description": "Page",
      "schema": {
       "type": "integer"
      }
     },
     {
      "name": "per_page",
      "in": "query",
      "description": "Elements per page",
      "schema": {
       "type": "integer"
      }
     },
     {
      "name": "include_free_companies",
      "in": "query",
      "description": "By default the endpoint excludes free companies. Provide include_free_companies=true to include them",
      "schema": {
       "type": "boolean"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "OK",
      "headers": {
       "Per-Page": {
        "description": "Number of items retrieved per page",
        "schema": {
         "type": "integer"
        }
       },
       "Total": {
        "description": "Total number of items to be retrieved",
        "schema": {
         "type": "integer"
        }
       },
       "Link": {
        "description": "Link headers for the first, prev, next, and last link",
        "schema": {
         "type": "string"
        }
       }
      },
      "content": {
       "application/json": {
        "schema": {
         "title": "arrayOfCompanies",
         "type": "array",
         "items": {
          "type": "object",
          "title": "Company",
          "description": "Company",
          "properties": {
           "id": {
            "type": "integer",
            "description": "Company id",
            "example": 1
           },
           "name": {
            "type": "string",
            "description": "Company name",
            "example": "ABC Drywall"
           },
           "is_active": {
            "type": "boolean",
            "description": "Company is active status",
            "example": true
           },
           "logo_url": {
            "type": "string",
            "description": "Company Logo URL",
            "example": "https://pro-core.com/prostore/logo.gif"
           },
           "pcn_business_experience": {
            "type": "boolean",
            "description": "Company has business experience enabled",
            "example": true,
            "nullable": true
           },
           "my_company": {
            "type": "boolean",
            "description": "The current user is an active employee of this company. This will only return as true for a single company in the response.",
            "example": true,
            "nullable": true
           }
          }
         }
        }
       }
