      "content": "import http.client\n\nconn = http.client.HTTPSConnection(\"api.procore.com\")\n\npayload = \"{\\\"program\\\":{\\\"name\\\":\\\"Program A\\\",\\\"address_freeform\\\":\\\"500 Construction Way, Santa Barbara\\\",\\\"website\\\":\\\"http://www.example.com\\\",\\\"zip\\\":91013}}\"\n\nheaders = { 'content-type': \"application/json\" }\n\nconn.request(\"PATCH\", \"/rest/v1.0/companies/%7Bcompany_id%7D/programs/%7Bid%7D\", payload, headers)\n\nres = conn.getresponse()\ndata = res.read()\n\nprint(data.decode(\"utf-8\"))"
