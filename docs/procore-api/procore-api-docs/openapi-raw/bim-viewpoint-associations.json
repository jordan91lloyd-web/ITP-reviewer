      "mimeType": "application/json",
      "title": "C#",
      "content": "var client = new HttpClient();\nvar request = new HttpRequestMessage\n{\n    Method = HttpMethod.Post,\n    RequestUri = new Uri(\"https://api.procore.com/rest/v1.0/bim_viewpoints/%7Bbim_viewpoint_id%7D/associations\"),\n    Content = new StringContent(\"{\\\"project_id\\\":12345,\\\"procore_item\\\":{\\\"item_id\\\":1,\\\"item_type\\\":\\\"CoordinationIssue\\\",\\\"primary\\\":true}}\")\n    {\n        Headers =\n        {\n            ContentType = new MediaTypeHeaderValue(\"application/json\")\n        }\n    }\n};\nusing (var response = await client.SendAsync(request))\n{\n    response.EnsureSuccessStatusCode();\n    var body = await response.Content.ReadAsStringAsync();\n    Console.WriteLine(body);\n}"
