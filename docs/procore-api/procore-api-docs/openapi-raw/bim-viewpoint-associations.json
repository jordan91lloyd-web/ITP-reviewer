   "post": {
    "x-doc": {
     "visibility": "public",
     "stage": "ga",
     "exposure": "public"
    },
    "summary": "Create Viewpoint and Procore Item association",
    "description": "A BIM Viewpoint can be associated with other procore items. This API endpoint creates that association.",
    "tags": [
     "BIM Viewpoints"
    ],
    "parameters": [
     {
      "name": "bim_viewpoint_id",
      "in": "path",
      "description": "BIM Viewpoint ID",
      "required": true,
      "schema": {
       "type": "integer"
      }
     }
    ],
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "title": "Body",
        "type": "object",
        "required": [
         "project_id"
        ],
        "properties": {
         "project_id": {
          "type": "integer",
          "description": "Unique identifier for the project.",
          "example": 12345
         },
         "procore_item": {
          "title": "Procore item details",
          "type": "object",
          "description": "Details of Procore item to be linked to a BimViewpoint",
          "required": [
           "item_id",
           "item_type"
          ],
          "properties": {
           "item_id": {
            "type": "integer",
            "description": "Id of the Procore item to be associated",
            "example": 1
           },
           "item_type": {
            "type": "string",
            "description": "Type of the Procore item to be associated",
            "example": "CoordinationIssue",
            "enum": [
             "BimModelRevision",
             "Comment",
             "CoordinationIssue"
            ]
           },
           "primary": {
            "type": "boolean",
            "description": "Set as primary viewpoint for the procore item. Only applicable for BimModelRevision",
            "example": true
           }
          }
         }
        }
       }
      }
     },
     "required": true
    },
