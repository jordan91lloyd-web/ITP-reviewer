   "get": {
    "x-doc": {
     "visibility": "public",
     "stage": "ga",
     "exposure": "public"
    },
    "summary": "Get a Workflow Template Version",
    "description": "Returns the details of a specific workflow template version.",
    "tags": [
     "Workflow Template Versions"
    ],
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "description": "Workflows Templates Version (Show)",
         "properties": {
          "data": {
           "type": "object",
           "description": "View of a template version",
           "properties": {
            "id": {
             "type": "string",
             "description": "Unique identifier for the version",
             "example": "1318"
            },
            "version": {
             "type": "string",
             "description": "Version number",
             "example": "1.0.0"
            },
            "created_at": {
             "type": "string",
             "format": "date-time",
             "description": "Date when the version was created",
             "example": "2018-04-20T16:20:57Z"
            },
            "updated_at": {
             "type": "string",
             "format": "date-time",
             "description": "Date when the version was last updated",
             "example": "2018-04-20T16:20:57Z"
            },
            "tool_type": {
             "type": "string",
             "example": "purchase_order_contract",
             "description": "The type of tool this template is for"
            },
            "tool_subtype": {
             "type": "string",
             "nullable": true,
             "example": "-1234",
             "description": "The subtype of tool this template is for (only applies to \"correspondence\" types)"
            },
            "format": {
             "type": "string",
             "description": "Workflow layout format (`diagram` or `linear`).",
             "enum": [
              "diagram",
              "linear"
             ],
             "example": "diagram"
            },
            "steps": {
             "type": "array",
             "items": {
              "type": "object",
              "properties": {
               "uuid": {
                "type": "string",
                "description": "UUID of the step",
                "example": "2d931510-d99f-494a-8c67-87feb05e1594"
               },
               "name": {
                "type": "string",
                "description": "The step name",
                "example": "Step 1"
               },
               "type": {
                "type": "string",
                "description": "The step type",
                "example": "STANDARD"
               },
               "responsible_groups": {
                "type": "array",
                "description": "List of responsible groups for the step",
                "items": {
                 "type": "object",
                 "properties": {
                  "uuid": {
                   "type": "string",
                   "description": "UUID of the responsible group",
                   "example": "39091882-2593-4a60-85fb-689d42b55a55"
                  },
                  "responses_required": {
                   "type": "string",
                   "description": "The number of responses required",
                   "example": "ONE"
                  },
                  "role_type": {
                   "type": "string",
                   "description": "Role of the responsible group on the step.",
                   "example": "responder",
                   "enum": [
                    "responder",
                    "commenter"
                   ]
                  },
                  "deferred": {
                   "type": "boolean",
                   "description": "When true, the assignee for this responsible group is chosen at item configuration time rather than in the template. Defaults to `false` when omitted.",
                   "example": false
                  }
                 }
                }
               }
              }
             }
            },
            "dynamic_steps": {
             "type": "array",
             "items": {
              "type": "object",
              "properties": {
               "uuid": {
                "type": "string",
                "description": "UUID of the step",
                "example": "2d931510-d99f-494a-8c67-87feb05e1594"
               },
               "name": {
                "type": "string",
                "description": "The step name",
                "example": "Step 1"
               },
               "type": {
                "type": "string",
                "description": "The step type",
                "example": "WORKFLOW"
               },
               "configuration": {
                "type": "object",
                "description": "Configuration for the dynamic step",
                "additionalProperties": true
               }
              }
             }
            },
            "responsible_groups": {
             "type": "array",
             "description": "List of responsible groups for the step",
             "items": {
              "type": "object",
              "properties": {
               "uuid": {
                "type": "string",
                "description": "UUID of the responsible group",
                "example": "39091882-2593-4a60-85fb-689d42b55a55"
               },
               "name": {
                "type": "string",
                "description": "The name of the responsible group",
                "example": "Item Creator"
               },
               "type": {
                "type": "string",
                "description": "The responsible group type",
                "example": "ITEM_CREATOR"
               }
              }
             }
            },
            "flow_visualizer_settings": {
             "type": "object",
             "description": "React-flow visualization settings for the workflow template",
             "nullable": true,
             "properties": {
              "nodes": {
               "type": "array",
               "description": "React-flow nodes configuration",
               "items": {
                "type": "object",
                "description": "Node configuration object",
                "required": [
                 "id",
                 "type",
                 "position"
                ],
                "properties": {
                 "id": {
                  "type": "string",
                  "description": "Unique identifier for the node",
                  "example": "node1"
                 },
                 "type": {
                  "type": "string",
                  "description": "Type of node (e.g., step, start, end)",
                  "example": "step"
                 },
                 "position": {
                  "type": "object",
                  "required": [
                   "x",
                   "y"
                  ],
                  "properties": {
                   "x": {
                    "type": "number",
                    "description": "X coordinate position",
                    "example": 100
                   },
                   "y": {
                    "type": "number",
                    "description": "Y coordinate position",
                    "example": 200
                   }
                  }
                 },
                 "data": {
                  "type": "object",
                  "description": "Additional node data",
                  "additionalProperties": true,
                  "example": {
                   "label": "Start Step"
                  }
                 }
                },
                "additionalProperties": true
               }
              },
              "edges": {
               "type": "array",
               "description": "React-flow edges configuration",
               "items": {
                "type": "object",
                "description": "Edge configuration object",
                "required": [
                 "id",
                 "source",
                 "target"
                ],
                "properties": {
                 "id": {
                  "type": "string",
                  "description": "Unique identifier for the edge",
                  "example": "edge1"
                 },
                 "source": {
                  "type": "string",
                  "description": "Source node ID",
                  "example": "node1"
                 },
                 "target": {
                  "type": "string",
                  "description": "Target node ID",
                  "example": "node2"
                 },
                 "type": {
                  "type": "string",
                  "description": "Type of edge (e.g., default, smoothstep)",
                  "example": "default"
                 },
                 "sourceHandle": {
                  "type": "string",
                  "description": "Source handle ID",
                  "example": "handle1"
                 },
                 "targetHandle": {
                  "type": "string",
                  "description": "Target handle ID",
                  "example": "handle2"
                 }
                },
                "additionalProperties": true
               }
              }
             }
            }
           }
          }
         }
        }
       }
      }
