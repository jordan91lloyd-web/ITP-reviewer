           "id": {
            "type": "integer",
            "description": "Unique identifier of the Submittal Log. Use as the `{id}` path parameter to retrieve a single Submittal Log.",
            "example": 252579
           },
           "title": {
            "type": "string",
            "description": "Title of the Submittal Log.",
            "example": "Steel D8 Beam"
           },
           "number": {
            "type": "string",
            "description": "User-facing Submittal Log number (may be alphanumeric).",
            "example": "49"
           },
           "revision": {
            "type": "string",
            "description": "Revision label of the Submittal Log.",
            "example": "0"
           },
           "due_date": {
            "type": "string",
            "format": "date",
