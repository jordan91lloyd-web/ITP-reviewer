           },
           "attachment_count": {
            "type": "integer",
            "description": "Number of files attached to the Submittal Log.",
            "example": 1
           },
           "status": {
            "type": "string",
            "description": "Current status label of the Submittal Log (for example, Open or Closed).",
            "example": "Closed"
           },
           "closed": {
            "type": "boolean",
            "description": "True when the Submittal Log is in a closed status.",
            "example": true
           },
           "specification_section": {
            "type": "object",
            "description": "Specification section the Submittal Log belongs to. Omitted when the log is not associated with a section.",
            "properties": {
             "id": {
              "type": "integer",
              "description": "Unique identifier of the specification section.",
              "example": 212630
             },
             "description": {
              "type": "string",
              "description": "Description of the specification section.",
              "example": "Metal Fabrications"
             },
             "section": {
              "type": "string",
              "description": "Specification section number.",
              "example": "55000"
             }
            }
           },
           "package": {
            "type": "object",
            "description": "Submittal Package the log belongs to. Omitted when the log is not part of a package.",
            "properties": {
             "id": {
              "type": "string",
              "description": "Unique identifier of the Submittal Package.",
              "example": 90210
             },
             "title": {
              "type": "string",
              "description": "Title of the Submittal Package.",
              "example": "Somebody's Package"
             }
            }
           },
           "ball_in_court": {
            "type": "array",
            "description": "Users currently responsible for acting on the Submittal Log (the \"ball in court\").",
            "items": {
             "type": "object",
             "properties": {
              "id": {
               "type": "integer",
               "description": "Unique identifier of the user.",
               "example": 160586
              },
              "login": {
               "type": "string",
               "description": "Email address of the user.",
