             "name": {
              "type": "string",
              "description": "Full location name, including parent locations.",
              "example": "1space>1 space"
             },
             "node_name": {
              "type": "string",
              "description": "Name of this location node, without parent locations.",
              "example": "1 space"
             },
             "parent_id": {
              "type": "integer",
              "description": "ID of the parent location, if any.",
              "example": 788866
             },
             "created_at": {
              "type": "string",
              "format": "date-time",
              "description": "Timestamp of Location creation",
              "example": "2016-08-01T23:33:54Z"
             },
             "updated_at": {
              "type": "string",
              "format": "date-time",
              "description": "Timestamp of last update to Location",
              "example": "2016-08-01T23:33:54Z"
             }
            }
           }
          }
         }
        }
