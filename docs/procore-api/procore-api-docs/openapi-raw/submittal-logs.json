              },
              "name": {
               "type": "string",
               "description": "Display name of the user.",
               "example": "Carl Contractor"
              }
             }
            }
           },
           "responses": {
            "type": "array",
            "description": "Distributed responses recorded for the Submittal Log. Present only when the log is closed and has a distributed submittal.",
