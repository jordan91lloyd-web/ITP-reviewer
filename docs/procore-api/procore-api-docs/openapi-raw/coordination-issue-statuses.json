          "data": {
           "type": "array",
           "description": "Available status transitions for the coordination issue.",
           "items": {
            "type": "object",
            "required": [
             "key",
             "label",
             "action_label",
             "is_primary"
            ],
            "properties": {
             "key": {
              "type": "string",
              "description": "The status key value to use when updating the coordination issue.",
              "example": "ready_for_review"
             },
             "label": {
              "type": "string",
              "description": "The translated display name of the status.",
              "example": "Ready for review"
             },
             "action_label": {
              "type": "string",
              "description": "The action button text for transitioning to this status.",
              "example": "Mark done"
             },
             "is_primary": {
              "type": "boolean",
              "description": "Whether this is the primary/recommended action for the current user.",
              "example": true
             }
            }
           }
          },
          "actions": {
           "type": "array",
           "description": "Additional actions available for the coordination issue (e.g., unlink RFI when blocked).",
