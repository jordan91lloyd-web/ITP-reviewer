 "paths": {
  "/rest/v1.0/field_production_report": {
   "get": {
    "x-doc": {
     "visibility": "public",
     "stage": "ga",
     "exposure": "public"
    },
    "summary": "List Field Production Report Summary",
    "description": "Returns an array calculated production rates across cost codes with an associated Budgeted Production Quantity",
    "tags": [
     "Field Production Report"
    ],
    "parameters": [
     {
      "name": "project_id",
      "in": "query",
      "required": true,
      "description": "Unique identifier for the project.",
      "schema": {
       "type": "integer"
      }
     },
     {
      "name": "page",
      "in": "query",
      "description": "Page",
      "schema": {
       "type": "integer"
      }
     },
     {
      "name": "per_page",
      "in": "query",
      "description": "Elements per page",
      "schema": {
       "type": "integer"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "OK",
      "headers": {
       "Per-Page": {
        "description": "Number of items retrieved per page",
        "schema": {
         "type": "integer"
        }
       },
       "Total": {
        "description": "Total number of items to be retrieved",
        "schema": {
         "type": "integer"
        }
       }
      },
      "content": {
       "application/json": {
        "schema": {
         "type": "array",
         "description": "Array of data calculations across budgeted cost codes",
         "items": {
          "type": "object",
          "description": "Field Production Report",
          "properties": {
           "cost_code_id": {
            "type": "integer",
            "description": "ID of associated cost code",
            "example": 302323
           },
           "cost_code": {
            "type": "string",
            "description": "Code and description of associated cost code",
            "example": "03 - Instructions"
           },
           "budgeted_hours": {
            "type": "number",
            "description": "Number of labor hours budgeted for the given cost code",
            "example": 100
           },
           "actual_hours": {
            "type": "number",
            "description": "Number of labor hours logged for the given cost code to date",
            "example": 46.5
           },
           "remaining_hours": {
            "type": "number",
            "description": "Budgeted Hours - Actual Hours",
            "example": 53.5
           },
           "hours_utilization": {
            "type": "string",
            "description": "(Actual Hours / Budgeted Hours) * 100",
            "example": "46.5%"
           },
           "projected_hours_at_completion": {
            "type": "number",
            "description": "(Actual Hours / Actual Quantities) * Remaining Quantities",
            "example": 108.5
           },
           "earned_hours": {
            "type": "number",
            "description": "(Budgeted Hours * Actual Quantities) / Budgeted Quantities",
            "example": 30
           },
           "budgeted_quantity": {
            "type": "number",
            "description": "Budgeted amount of a unit to install for the given cost code",
            "example": 100
           },
           "actual_quantity": {
            "type": "number",
            "description": "Actual amount of a unit installed for the given cost code to date",
            "example": 30
           },
           "remaining_quantities": {
            "type": "number",
            "description": "Budgeted Quantity - Actual Quantity",
            "example": 70
           },
           "unit_of_measure": {
            "type": "string",
            "description": "One of the following (ea, ls, lf, sf, sy, cy, mm, m, m^2, m^3, lbs, t, kg, ton)",
            "example": "ea"
           },
           "percent_complete": {
            "type": "string",
            "description": "(Actual Quantity / Budgeted Quantity) * 100",
            "example": "30%"
           },
           "budgeted_production_rate": {
            "type": "number",
            "description": "Budgeted Quantity / Budgeted Hours",
            "example": 1
           },
           "actual_production_rate": {
            "type": "number",
            "description": "Actual Quantity / Actual Hours",
            "example": 0.65
           },
           "production_rate_variance": {
            "type": "number",
            "description": "Actual Production Rate - Budgeted Production Rate",
            "example": -0.35
           },
           "is_budgeted": {
            "type": "string",
            "description": "Cost code budgeted (yes/no)",
            "example": "Yes"
           },
           "sub_job_name": {
            "type": "string",
            "description": "Name of the associated sub job",
            "example": "Building 1"
           },
           "sub_job_id": {
            "type": "integer",
            "description": "ID of the associated sub job",
            "example": 392483
           }
          }
         }
        }
       }
      }
     },
     "401": {
      "description": "Unauthorized",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
