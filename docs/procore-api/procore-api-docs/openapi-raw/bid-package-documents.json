    "x-code-samples": [
     {
      "id": "node_request",
      "title": "Node.js",
      "content": "const request = require('request');\n\nconst options = {\n  method: 'GET',\n  url: 'https://api.procore.com/rest/v1.0/companies/%7Bcompany_id%7D/planroom/bid_packages/%7Bbid_package_id%7D/documents',\n  qs: {\n    pdm_page: '1',\n    pdm_per_page: '10',\n    pdm_sort_by: 'created_at',\n    pdm_sort_order: 'desc',\n    pdm_search: '01HZ8K9M2N3P4Q5R6S7T8U9V0W'\n  }\n};\n\nrequest(options, function (error, response, body) {\n  if (error) throw new Error(error);\n\n  console.log(body);\n});\n"
